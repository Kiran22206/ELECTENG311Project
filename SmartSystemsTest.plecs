"SOR_SWP CLAMP 72 CLAMP 72 S_VSWITCH_5\n"
"V_GRN 54 MID -35\n"
"V_GRP 53 MID 50\n"
"V_ISCN 69 MID -65\n"
"V_ISCP 68 MID 65\n"
"V_ORN 67 VCLP -3.84\n"
"V_ORP 65 VCLP 4.32\n"
"V_OS 25 26 -32U\n"
"V4 40 OUT 0\n"
"V11 73 66 0\n"
"V12 72 64 0\n"
"VCM_MAX 90 VCC_B 0\n"
"VCM_MIN 89 VEE_B 0\n"
"XCL_AMP 68 69 VIMON MID 70 71 CLAMP_AMP_LO_0_TLV916x\n"
"XCL_SRC 74 75 CL_CLAMP MID VCCS_LIM_4_0_TLV916x\n"
"XCLAW_AMP VCC_CLP VEE_CLP VOUT_S MID 80 81 CLAMP_AMP_LO_0_TLV916x\n"
"XCLAW_SRC 82 83 CLAW_CLAMP MID VCCS_LIM_3_0_TLV916x\n"
"XCLAWN MID VIMON VEE_B 77 VCCS_LIM_CLAW-_0_TLV916x\n"
"XCLAWP VIMON MID 76 VCC_B VCCS_LIM_CLAW+_0_TLV916x\n"
"XE_N ESDP 26 VNSE_0_TLV916x\n"
"XGR_AMP 53 54 55 MID 56 57 CLAMP_AMP_HI_0_TLV916x\n"
"XGR_SRC 58 59 CLAMP MID VCCS_LIM_GR_0_TLV916x\n"
"XI_N MID 26 FEMT_0_TLV916x\n"
"XIN11 ESDN MID FEMT_0_TLV916x\n"
"XIQN MID VIMON VEE MID VCCS_LIMIT_IQ_0_TLV916x\n"
"XIQP VIMON MID MID VCC VCCS_LIMIT_IQ_0_TLV916x\n"
"XOL_SENSE MID 84 62 60 OL_SENSE_0_TLV916x\n"
"XVCCS_LIM_1 29 30 MID 28 VCCS_LIM_1_0_TLV916x\n"
"XVCCS_LIM_2 28 MID MID CLAMP VCCS_LIM_2_0_TLV916x\n"
"XVCCS_LIM_ZO 34 MID MID 37 VCCS_LIM_ZO_0_TLV916x\n"
"XVCM_CLAMP 91 MID 88 MID 90 89 VCCS_EXT_LIM_0_TLV916x\n"
".ENDS TLV916x\n"
"\n"
"*--------------- End of main subcircuit ----------------------\n"
"*--------------- References are appended below ---------------\n"
"\n"
".SUBCKT CLAMP_AMP_HI_0_TLV916x VC+ VC- VIN COM VO+ VO-\n"
".PARAM G=10\n"
"GVO- COM VO- VALUE = {IF(V(VIN,COM)<V(VC-,COM),((V(VC-,COM)-V(VIN,COM))*G),0)"
"}\n"
"GVO+ COM VO+ VALUE = {IF(V(VIN,COM)>V(VC+,COM),((V(VIN,COM)-V(VC+,COM))*G),0)"
"}\n"
".ENDS CLAMP_AMP_HI_0_TLV916x\n"
"\n"
".SUBCKT CLAMP_AMP_LO_0_TLV916x VC+ VC- VIN COM VO+ VO-\n"
".PARAM G=1\n"
"GVO- COM VO- VALUE = {IF(V(VIN,COM)<V(VC-,COM),((V(VC-,COM)-V(VIN,COM))*G),0)"
"}\n"
"GVO+ COM VO+ VALUE = {IF(V(VIN,COM)>V(VC+,COM),((V(VIN,COM)-V(VC+,COM))*G),0)"
"}\n"
".ENDS CLAMP_AMP_LO_0_TLV916x\n"
"\n"
".SUBCKT FEMT_0_TLV916x 1 2\n"
".PARAM FLWF=1E-3\n"
".PARAM GLFF={PWR(FLWF,0.25)*NLFF/1164}\n"
".PARAM NLFF=60\n"
".PARAM NVRF=60\n"
".PARAM RNVF={1.184*PWR(NVRF,2)}\n"
".MODEL DVNF D (KF={PWR(FLWF,0.5)/1E11} IS=1.0E-16)\n"
"D1 7 0 DVNF \n"
"D2 8 0 DVNF \n"
"E1 3 6 7 8 {GLFF}\n"
"E2 6 4 5 0 10\n"
"G1 1 2 3 4 1E-6\n"
"I1 0 7 10E-3\n"
"I2 0 8 10E-3\n"
"R1 3 0 1E9 \n"
"R2 3 0 1E9 \n"
"R3 3 6 1E9 \n"
"R4 5 0 {RNVF} \n"
"R5 5 0 {RNVF} \n"
"R6 3 4 1E9 \n"
"R7 4 0 1E9 \n"
".ENDS FEMT_0_TLV916x\n"
"\n"
".SUBCKT OL_SENSE_0_TLV916x COM SW+ OLN OLP\n"
"GSW+ COM SW+ VALUE = {IF((V(OLN,COM)>10E-3|V(OLP,COM)>10E-3),1,0)}\n"
".ENDS OL_SENSE_0_TLV916x\n"
"\n"
".SUBCKT VCCS_EXT_LIM_0_TLV916x VIN+ VIN- IOUT- IOUT+ VP+ VP-\n"
".PARAM GAIN=1\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VIN+,VIN-),V(VP-,VIN-),V(VP+,VIN-))}\n"
".ENDS VCCS_EXT_LIM_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_1_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1E-4\n"
".PARAM INEG=-.5\n"
".PARAM IPOS=.5\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_1_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_2_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1.26E-1\n"
".PARAM INEG=-5.9\n"
".PARAM IPOS=6.64\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_2_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_3_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1\n"
".PARAM INEG=-70E-3\n"
".PARAM IPOS=100E-3\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_3_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_4_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1\n"
".PARAM INEG=-200E-3\n"
".PARAM IPOS=200E-3\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_4_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_CLAW+_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
"G1 IOUT+ IOUT- TABLE {(V(VC+,VC-))} =(0, 6.87E-5)(15, 4.04E-4)(30, 7.93E-4)(4"
"5, 1.27E-3)(60, 1.8E-3)(70, 2.4E-3)(80,  3.75E-3)(90, 9.83E-3)\n"
".ENDS VCCS_LIM_CLAW+_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_CLAW-_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
"G1 IOUT+ IOUT- TABLE {(V(VC+,VC-))} =(0, 7.59E-5)(40, 1.21E-3)(60, 2E-3)(70, "
"2.61E-3)(80, 4.42E-3)(90, 9.61E-3)\n"
".ENDS VCCS_LIM_CLAW-_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_GR_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1\n"
".PARAM INEG=-12\n"
".PARAM IPOS=14\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_GR_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_ZO_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1\n"
".PARAM INEG=-2E3\n"
".PARAM IPOS=2E3\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_ZO_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIMIT_IQ_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1E-3\n"
"G1 IOUT- IOUT+ VALUE={IF((V(VC+,VC-)<=0),0,GAIN*V(VC+,VC-))}\n"
".ENDS VCCS_LIMIT_IQ_0_TLV916x\n"
"\n"
".SUBCKT VNSE_0_TLV916x 1 2\n"
".PARAM FLW=10\n"
".PARAM GLF={PWR(FLW,0.25)*NLF/1164}\n"
".PARAM NLF=64.13\n"
".PARAM NVR=4\n"
".PARAM RNV={1.184*PWR(NVR,2)}\n"
".MODEL DVN D (KF={PWR(FLW,0.5)/1E11} IS=1.0E-16)\n"
"D1 7 0 DVN \n"
"D2 8 0 DVN \n"
"E1 3 6 7 8 {GLF}\n"
"E2 6 4 5 0 10\n"
"E3 1 2 3 4 1\n"
"I1 0 7 10E-3\n"
"I2 0 8 10E-3\n"
"R1 3 0 1E9 \n"
"R2 3 0 1E9 \n"
"R3 3 6 1E9 \n"
"R4 5 0 {RNV} \n"
"R5 5 0 {RNV} \n"
"R6 3 4 1E9 \n"
"R7 4 0 1E9 \n"
".ENDS VNSE_0_TLV916x\n"
