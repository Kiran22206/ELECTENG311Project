"ROL_U1_U1_U1_S2 \n"
"R_U1_U1_U1_R3         U1_U1_U1_N15524294 U1_U1_U1_N15524300  10 TC=0,0 \n"
"V_U1_U1_U1_V5         U1_U1_U1_N15524028 0 2\n"
"X_U1_U1_U1_U46         U1_U1_N15517195 U1_ON_INT_PRE U1_U1_U1_N15524454   NOR"
"2_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=500E-3\n"
"X_U1_U1_U1_U44         U1_ON_INT_PRE U1_U1_N15517195 U1_U1_U1_N15524022   AND"
"2_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=500E-3\n"
"D_U1_U1_U1_D3         U1_U1_U1_ON_A U1_U1_U1_N15524028 DD \n"
"E_U1_U1_U1_E2         U1_U1_U1_HYS 0 TABLE { V(VIN, 0) }   ( (0,0)(1,0.07)(1."
"8,0.07)(3.5,0.05)(5.5,0.03) )\n"
"V_U1_U1_U1_V4         U1_U1_U1_N15523948 0 1\n"
"C_U1_U1_U1_C1         0 U1_U1_U1_ON_A  1n IC=0 \n"
"C_U1_U1_U1_C4         U1_U1_U1_N15524300 0  1n  \n"
"E_U1_U1_U1_E1         U1_U1_U1_THRISE 0 TABLE { V(VIN, 0) }   (  (0,0)(1,0.62"
")(1.8,0.62)(3.5,0.66)(5.5,0.71) )\n"
"X_U1_U1_S4    U1_ON_INT_PRE GND ON GND CHANNEL_X_U1_U1_S4 \n"
".ends TPS22917L_TRANS\n"
"\n"
"*--------------- End of main subcircuit ----------------------\n"
"*--------------- References are appended below ---------------\n"
"\n"
".MODEL DD D( IS=1F N=0.01 TT = 10p )\n"
".MODEL PMOS01 PMOS (VTO = -0.5 KP = 9.75 LAMBDA = 0.001)\n"
"\n"
".SUBCKT AND2_BASIC_GEN A B Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 \n"
"E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH}  &  V(B) > {VTHRESH},{VDD},{V"
"SS})}}\n"
"RINT YINT Y 1\n"
"CINT Y 0 1n\n"
".ENDS AND2_BASIC_GEN\n"
"\n"
".SUBCKT BUF_BASIC_GEN A  Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 \n"
"E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH} ,   {VDD},{VSS})}}\n"
"RINT YINT Y 1\n"
"CINT Y 0 1n\n"
".ENDS BUF_BASIC_GEN\n"
"\n"
".SUBCKT BUF_DELAY_BASIC_GEN A  Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 DELAY = 10n"
"\n"
"E_ABMGATE1    YINT1 0 VALUE {{IF(V(A) > {VTHRESH} ,  {VDD},{VSS})}}\n"
"RINT YINT1 YINT2 1\n"
"CINT YINT2 0 {DELAY*1.3}\n"
"E_ABMGATE2    YINT3 0 VALUE {{IF(V(YINT2) > {VTHRESH} ,   {VDD},{VSS})}}\n"
"RINT2 YINT3 Y 1\n"
"CINT2 Y 0 1n\n"
".ENDS BUF_DELAY_BASIC_GEN\n"
"\n"
".subckt CHANNEL_X_U1_U1_S4 1 2 3 4  \n"
"S_U1_U1_S4         3 4 1 2 _U1_U1_S4\n"
"RS_U1_U1_S4         1 2 1G\n"
".MODEL         _U1_U1_S4 VSWITCH Roff=1E9 Ron=750k Voff=0.8 Von=0.1\n"
".ends CHANNEL_X_U1_U1_S4\n"
"\n"
".subckt CHANNEL_X_U1_U1_S5 1 2 3 4  \n"
"S_U1_U1_S5         3 4 1 2 _U1_U1_S5\n"
"RS_U1_U1_S5         1 2 1G\n"
".MODEL         _U1_U1_S5 VSWITCH Roff=1E9 Ron=1 Voff=0.1 Von=0.8\n"
".ends CHANNEL_X_U1_U1_S5\n"
"\n"
".SUBCKT COMPHYS_BASIC_GEN INP INM HYS OUT PARAMS: VDD=1 VSS=0 VTHRESH=0.5   "
"\n"
"EIN INP1 INM1 INP INM 1 \n"
"EHYS INP1 INP2 VALUE { IF( V(1) > {VTHRESH},-V(HYS),0) }\n"
"EOUT OUT 0 VALUE { IF( V(INP2)>V(INM1), {VDD} ,{VSS}) }\n"
"R1 OUT 1 1\n"
"C1 1 0 5n\n"
"RINP1 INP1 0 1K\n"
".ENDS COMPHYS_BASIC_GEN\n"
"\n"
".subckt CONTROL_U1_U1_U1_S1 1 2 3 4  \n"
"S_U1_U1_U1_S1         3 4 1 2 _U1_U1_U1_S1\n"
"RS_U1_U1_U1_S1         1 2 1G\n"
".MODEL         _U1_U1_U1_S1 VSWITCH Roff=100e6 Ron=1m Voff=0.2 Von=0.8\n"
".ends CONTROL_U1_U1_U1_S1\n"
"\n"
".subckt CONTROL_U1_U1_U1_S2 1 2 3 4  \n"
"S_U1_U1_U1_S2         3 4 1 2 _U1_U1_U1_S2\n"
"RS_U1_U1_U1_S2         1 2 1G\n"
