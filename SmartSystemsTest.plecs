".ends CONTROL_U1_U1_U1_S2\n"
"\n"
".subckt DRIVER_U1_U1_U2_F1 1 2 3 4  \n"
"F_U1_U1_U2_F1         3 4 VF_U1_U1_U2_F1 1\n"
"VF_U1_U1_U2_F1         1 2 0V\n"
".ends DRIVER_U1_U1_U2_F1\n"
"\n"
".subckt DRIVER_U1_U1_U2_H1 1 2 3 4  \n"
"H_U1_U1_U2_H1         3 4 VH_U1_U1_U2_H1 1\n"
"VH_U1_U1_U2_H1         1 2 0V\n"
".ends DRIVER_U1_U1_U2_H1\n"
"\n"
".subckt DRIVER_U1_U1_U2_S10 1 2 3 4  \n"
"S_U1_U1_U2_S10         3 4 1 2 _U1_U1_U2_S10\n"
"RS_U1_U1_U2_S10         1 2 1G\n"
".MODEL         _U1_U1_U2_S10 VSWITCH Roff=1e9 Ron=0.1m Voff=1 Von=0\n"
".ends DRIVER_U1_U1_U2_S10\n"
"\n"
