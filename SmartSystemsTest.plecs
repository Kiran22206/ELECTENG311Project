"GOR   VEE N1 VALUE = {G_OR*(MIN(V(A,VEE) + V(B,VEE),1))} \n"
"GNOR  VEE N1 VALUE = {G_NOR*(1 - MIN(V(A,VEE) + V(B,VEE),1))} \n"
"GXOR  VEE N1 VALUE = {G_XOR*((1 - V(A,VEE))*V(B,VEE) + V(A,VEE)*(1 - V(B,VEE)"
"))} \n"
"GXNOR VEE N1 VALUE = {G_XNOR*(1 - ((1 - V(A,VEE))*V(B,VEE) + V(A,VEE)*(1 - V("
"B,VEE))))} \n"
"RN1 N1 VEE 1 \n"
"EOUT OUT VEE N1 VEE 1 \n"
".ENDS \n"
"\n"
